# Variables de entorno - Entintados Paraguay Bot
# Copiá este archivo como .env y completá con tus datos

# Token de verificación (lo inventás vos, puede ser cualquier palabra)
VERIFY_TOKEN=entintados_token_2024

# Token de acceso de WhatsApp (lo obtenés en Meta for Developers)
WHATSAPP_TOKEN=tu_token_aqui

# ID del número de teléfono (lo obtenés en Meta for Developers)
PHONE_NUMBER_ID=tu_phone_number_id_aqui

# Puerto del servidor (Render lo asigna automáticamente)
PORT=3000
